<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 so the full parity + unit suite runs on ubuntu / macos / windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SkylinePrism.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\Pwiz.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkylinePrism.Core\SkylinePrism.Core.csproj" />
    <ProjectReference Include="..\..\src\SkylinePrism.Cli\SkylinePrism.Cli.csproj" />
    <!--
      The pwiz bridge, OPT-IN: `dotnet build -p:PrismWithPwiz=true`.

      Off by default because referencing it drags the whole pwiz-sharp tree into the build, and with
      it 58 of that tree's own warnings - which would end the warning-free build this repo keeps, for
      code that is not ours to fix. The default build and the default `dotnet test` are therefore
      exactly what they were, and CI (which has no pwiz checkout) is unaffected.
    -->
    <ProjectReference Include="..\..\src\SkylinePrism.Pwiz\SkylinePrism.Pwiz.csproj"
                      Condition="'$(PrismWithPwiz)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(PrismWithPwiz)' == 'true' and Exists('$(PwizSharpDir)\vendor-assemblies\Thermo\ThermoFisher.CommonCore.Data.dll')">
    <!-- Spike only: measuring whether bypassing pwiz for Thermo is worth a vendor-specific path. -->
    <Reference Include="ThermoFisher.CommonCore.Data">
      <HintPath>$(PwizSharpDir)\vendor-assemblies\Thermo\ThermoFisher.CommonCore.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.RawFileReader">
      <HintPath>$(PwizSharpDir)\vendor-assemblies\Thermo\ThermoFisher.CommonCore.RawFileReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(PrismWithPwiz)' != 'true'">
    <!-- Name types that only exist in a pwiz build, so they cannot be compiled without one. -->
    <Compile Remove="RawData\PwizMs2SignalReaderTests.cs" />
    <Compile Remove="Qc\Ms2AcquiredFractionTests.cs" />
    <Compile Remove="RawData\Ms2ReadThroughputTests.cs" />
    <Compile Remove="RawData\ThermoDirectSpikeTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-language golden fixtures produced by the Python pipeline, copied next to
         the test assembly and resolved via AppContext.BaseDirectory. -->
    <Content Include="..\fixtures\**\*.*"
             Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
