<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only smoke tests for the RPC framing (SkylinePrism.Skyline) and WPF
         view-models (SkylinePrism.App). Gated to the windows CI runner. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SkylinePrism.Tests.Windows</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Without these, SkylinePrism.Skyline and SkylinePrism.App are invisible to the XPlat Code
         Coverage collector: the Skyline integration layer reported as uncovered only because nothing
         was measuring it. Matches SkylinePrism.Tests. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkylinePrism.Skyline\SkylinePrism.Skyline.csproj" />
    <ProjectReference Include="..\..\src\SkylinePrism.App\SkylinePrism.App.csproj" />
  </ItemGroup>

</Project>
