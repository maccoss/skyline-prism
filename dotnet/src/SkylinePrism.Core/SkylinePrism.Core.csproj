<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0: no WPF, no named pipes -> runs on Windows, Linux, macOS.
         This is the shared algorithm / IO / QC layer for the cross-platform CLI. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SkylinePrism.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Parquet.Net" Version="5.6.1" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned ahead of what Microsoft.Data.Sqlite resolves (2.1.11), which still carries
         GHSA-2m69-gcr7-jv3q. The advisory is against the bundled SQLite native library, so the fix is a
         newer e_sqlite3 build rather than anything in our code. Direct reference because a transitive
         one cannot be raised. Drop this line once Microsoft.Data.Sqlite pulls a patched version itself. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
    <PackageReference Include="ScottPlot" Version="5.0.55" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkylinePrism.Tests" />
  </ItemGroup>

</Project>
