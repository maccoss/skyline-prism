<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0: no WPF, no named pipes -> runs on Windows, Linux, macOS.
         This is the shared algorithm / IO / QC layer for the cross-platform CLI. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SkylinePrism.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkylinePrism.Tests" />
  </ItemGroup>

</Project>
