<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: no WPF, no named pipes -> runs on Windows, Linux, macOS.
         This is the shared algorithm / IO / QC layer for the cross-platform CLI. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SkylinePrism.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="ScottPlot" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkylinePrism.Tests" />
  </ItemGroup>

</Project>
