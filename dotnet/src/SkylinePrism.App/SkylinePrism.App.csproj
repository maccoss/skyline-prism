<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The WinExe that Skyline launches as an external tool. WPF + interactive
         ScottPlot views (Layer 11). AssemblyName must match the Command in the
         tool-inf manifest (SkylinePrism.exe). -->
    <OutputType>WinExe</OutputType>
    <!-- Platform version 10.0.19041 (Windows 10 2004), NOT the default 7.0. ScottPlot.WPF brings
         SkiaSharp.Views.WPF, which ships lib/net462, lib/net6.0-windows10.0.19041 and
         lib/net8.0-windows10.0.19041 - so a project on net10.0-windows7.0 cannot match the modern
         assets and NuGet silently falls back to net462, taking NU1701 and running WPF controls
         through the .NET Framework compatibility shim. This is the smallest bar that resolves them;
         Windows 11 was authorised but is not required, and asking for more than is needed only
         narrows who can run the tool. Raising it further is a user-facing decision, so state the
         minimum in tool-inf/info.properties whenever it moves. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SkylinePrism</AssemblyName>
    <RootNamespace>SkylinePrism.App</RootNamespace>
    <!-- PRISM app icon: embedded in the exe (Explorer + default taskbar/title-bar
         icon). Also referenced as a WPF resource by MainWindow's Icon for a crisp
         title-bar render. -->
    <ApplicationIcon>skyline-prism.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="skyline-prism.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the pieces of the UI that are pure logic (label placement, for one) can be tested
         without standing up a window. -->
    <InternalsVisibleTo Include="SkylinePrism.Tests.Windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <Import Project="..\..\Pwiz.props" />

  <ItemGroup>
    <ProjectReference Include="..\SkylinePrism.Core\SkylinePrism.Core.csproj" />
    <ProjectReference Include="..\SkylinePrism.Skyline\SkylinePrism.Skyline.csproj" />
    <!--
      The instrument-file reader, which is what lets the tool measure ACQUIRED MS2 signal - the
      denominator no Skyline export carries. Its assemblies are published beside the exe and so
      travel in SkylinePrism.zip: ~36 MB, mostly vendor natives (baf2sql_c.dll is 17 MB of it).

      OPT-IN, via -p:PrismWithPwiz=true, which build\package.proj sets. Two reasons it is not just
      "on when a checkout exists": a developer without one must still be able to build and run the
      tool, and a developer WITH one must not silently lose the warning-free build - referencing
      pwiz-sharp brings 58 of its own warnings, which are not ours to fix. It is NOT optional for a
      release: the RequirePwiz check in build\package.proj refuses to package a zip without the
      reader rather than shipping one that silently cannot open a raw file.

      Bundling is deliberate and temporary. Skyline is being ported to C# and will install pwiz
      itself; PRISM is a Skyline external tool, so once that lands the tool should resolve these
      assemblies from Skyline's own installation instead of carrying its own copies. Keep the
      dependency reachable through SkylinePrism.Pwiz alone so that swap is one reference.
    -->
    <ProjectReference Include="..\SkylinePrism.Pwiz\SkylinePrism.Pwiz.csproj"
                      Condition="'$(PwizAvailable)' == 'true' and '$(PrismWithPwiz)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skyline tool manifest, copied next to the exe and staged into the tool zip. -->
    <None Include="tool-inf\info.properties" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tool-inf\SkylinePrism.properties" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
