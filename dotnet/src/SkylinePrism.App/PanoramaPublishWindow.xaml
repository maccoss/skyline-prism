<Window x:Class="SkylinePrism.App.PanoramaPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish to Panorama" Height="840" Width="820" MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                   Text="Publishes this output directory to Panorama: the QC and quant reports as wiki pages, each in a folder you choose, the whole directory uploaded next to the folder that holds the raw files, and links to all of it on a folder's page. Publishing again updates the same pages (Panorama keeps earlier versions) and uploads only files that changed." />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="ServerBox" Width="220" VerticalAlignment="Center" LostFocus="OnServerChanged" />
            <Button x:Name="SignInButton" Content="Sign in..." Padding="10,2" Margin="8,0,0,0" DockPanel.Dock="Right"
                    Click="OnSignIn" ToolTip="Sign in with an API key or a Panorama user name and password." />
            <TextBlock x:Name="SignInText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="#555" />
        </DockPanel>

        <GroupBox Grid.Row="2">
            <GroupBox.Header>
                <CheckBox x:Name="QcCheck" Content="QC report as a wiki page" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox x:Name="QcFolderBox" Grid.Column="1" Margin="0,0,6,4" TextChanged="OnTargetsChanged"
                         ToolTip="The Panorama folder whose wiki gets the page. A path, or an address pasted from a browser." />
                <Button Grid.Column="2" Content="Browse..." Padding="10,1" Margin="0,0,0,4" Click="OnBrowseQc" />
                <TextBlock Grid.Row="1" Text="Page:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="QcPageBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" TextChanged="OnTargetsChanged" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3">
            <GroupBox.Header>
                <CheckBox x:Name="QuantCheck" Content="Quant report as a wiki page" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="QuantContrastText" Grid.ColumnSpan="3" Foreground="#555" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox x:Name="QuantFolderBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,4" TextChanged="OnTargetsChanged"
                         ToolTip="The Panorama folder whose wiki gets the page. A path, or an address pasted from a browser." />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Padding="10,1" Margin="0,0,0,4" Click="OnBrowseQuant" />
                <TextBlock Grid.Row="2" Text="Page:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="QuantPageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,6,0" TextChanged="OnTargetsChanged" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4">
            <GroupBox.Header>
                <CheckBox x:Name="UploadCheck" Content="Upload the output directory next to the raw files" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Raw files folder:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox x:Name="RawFolderBox" Grid.Column="1" Margin="0,0,6,4" TextChanged="OnTargetsChanged"
                         ToolTip="The folder on Panorama that holds this experiment's raw files, inside @files. The output directory goes beside it, under its own name." />
                <Button Grid.Column="2" Content="Browse..." Padding="10,1" Margin="0,0,0,4" Click="OnBrowseRaw" />
                <TextBlock x:Name="DestinationText" Grid.Row="1" Grid.ColumnSpan="3" Foreground="#555" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="5">
            <GroupBox.Header>
                <CheckBox x:Name="LinksCheck" Content="Links on the folder's page" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Foreground="#555" Margin="0,0,0,4" TextWrapping="Wrap"
                           Text="A small wiki page linking the QC report, every quant report published from this output directory and the uploaded files, shown on the folder's own page right after Targeted MS Runs. Adding it there needs folder administrator permission; without it the page is still published." />
                <TextBlock Grid.Row="1" Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox x:Name="LinksFolderBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,4" TextChanged="OnLinksFolderChanged"
                         ToolTip="The Panorama folder whose page shows the links. Follows the QC report's folder (the quant report's, without one) until you change it." />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Padding="10,1" Margin="0,0,0,4" Click="OnBrowseLinks" />
                <TextBlock Grid.Row="2" Text="Page:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="LinksPageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,6,0" TextChanged="OnTargetsChanged" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="6" Margin="2,0,0,8">
            <CheckBox x:Name="ReplaceEditedCheck" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged" Margin="0,0,0,4"
                      Content="Replace a page edited on Panorama since PRISM published it"
                      ToolTip="Without this, a page someone changed by hand on Panorama - or a page of that name PRISM did not write - is refused rather than overwritten. Panorama keeps the edited version in the page's history either way." />
            <CheckBox x:Name="TakeOverCheck" Checked="OnTargetsChanged" Unchecked="OnTargetsChanged"
                      Content="Take over a page published from a different output directory"
                      ToolTip="Without this, a page PRISM published from another output directory - another analysis whose directory name gives the same page name, or this directory if its panorama.json was lost - is refused rather than replaced." />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="7" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Background="#fafbfc" MinHeight="80" />

        <ProgressBar x:Name="UploadProgress" Grid.Row="8" Height="10" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock x:Name="ResultsText" Grid.Row="9" Margin="0,8,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CommandButton" Content="Show Command Line" Padding="12,4" Margin="0,0,8,0" Click="OnShowCommand"
                    ToolTip="The prism publish command that does the same thing, for a headless run." />
            <Button x:Name="PublishButton" Content="Publish" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="OnPublish" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,4" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
