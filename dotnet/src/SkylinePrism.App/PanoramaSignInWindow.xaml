<Window x:Class="SkylinePrism.App.PanoramaSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Panorama" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10" />

        <RadioButton x:Name="ApiKeyChoice" Content="API key (recommended)" IsChecked="True" GroupName="How"
                     Checked="OnHowChanged" />
        <TextBlock Margin="20,2,0,4" TextWrapping="Wrap" Foreground="#777" FontSize="11"
                   Text="Generate one on Panorama from your name's menu, External Tool Access. A key can be revoked without changing your password." />
        <PasswordBox x:Name="ApiKeyBox" Margin="20,0,0,8" />

        <RadioButton x:Name="LoginChoice" Content="Panorama user name and password" GroupName="How" Checked="OnHowChanged" />
        <Grid Margin="20,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Email:" VerticalAlignment="Center" Margin="0,0,8,4" />
            <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,0,0,4" IsEnabled="False" />
            <TextBlock Grid.Row="1" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" IsEnabled="False" />
        </Grid>

        <CheckBox x:Name="RememberCheck" Content="Remember on this computer (Windows Credential Manager)" IsChecked="True" Margin="0,4,0,0" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#a33" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SignInButton" Content="Sign in" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="OnSignIn" />
            <Button Content="Cancel" Padding="16,4" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
