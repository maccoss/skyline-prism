<Window x:Class="SkylinePrism.App.FeatureDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Feature detail" Height="520" Width="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold"
                   Foreground="#1a3c6e" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" DockPanel.Dock="Bottom" Foreground="#888" FontSize="11"
                   Margin="0,6,0,0" TextWrapping="Wrap" />
        <sp:WpfPlot x:Name="DetailPlot" />
    </DockPanel>
</Window>
