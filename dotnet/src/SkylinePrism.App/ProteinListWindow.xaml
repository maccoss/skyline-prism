<Window x:Class="SkylinePrism.App.ProteinListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protein lists" Height="560" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#555"
                   Text="Named sets of proteins that highlight on the Dynamic Range plot and can define a marker normalization. Members may be UniProt accessions, gene names or full protein names; all three are matched. Predefined panels ship with PRISM and are read-only - duplicate one to change it. Your own lists are saved per user, so they are available in every project." />

        <TabControl Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" x:Name="ListTabs"
                    SelectionChanged="OnListTabChanged">
            <TabItem Header="My lists">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add" Padding="12,3" Click="OnAddList" />
                        <Button Content="Remove" Padding="12,3" Margin="6,0,0,0" Click="OnRemoveList" />
                    </StackPanel>
                    <ListBox x:Name="ListsBox" SelectionChanged="OnSelectedListChanged">
                        <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center"
                                      ToolTip="Show this list on the plot" />
                            <Border Width="14" Height="14" Margin="6,0" CornerRadius="2"
                                    Background="{Binding Brush}" BorderBrush="#555" BorderThickness="1" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountLabel}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Foreground="#888" />
                        </StackPanel>
                    </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Predefined">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Duplicate to my lists" Padding="12,3" Click="OnDuplicateShipped"
                                ToolTip="Make an editable copy under My lists. The predefined panel is left alone, so it keeps meaning the same thing on every machine." />
                    </StackPanel>
                    <ListBox x:Name="ShippedBox" SelectionChanged="OnSelectedListChanged"
                             IsSynchronizedWithCurrentItem="False">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="False" Margin="0,2,0,0">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           Foreground="#888" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="12,2,0,0" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center"
                                      ToolTip="Show this list on the plot" />
                            <Border Width="14" Height="14" Margin="6,0" CornerRadius="2"
                                    Background="{Binding Brush}" BorderBrush="#555" BorderThickness="1" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountLabel}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Foreground="#888" />
                        </StackPanel>
                    </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Grid.Column="1" x:Name="DetailPanel" IsEnabled="False">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" x:Name="NameBox" VerticalAlignment="Center"
                         TextChanged="OnNameChanged" />
                <TextBlock Grid.Column="2" Text="Color:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="3" x:Name="ColorCombo" Width="150"
                          SelectionChanged="OnColorChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" Margin="0,0,6,0" CornerRadius="2"
                                        Background="{Binding Brush}" BorderBrush="#555" BorderThickness="1" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="ShowLabelsCheck" Content="Label this list's members on the plot"
                          VerticalAlignment="Center" Click="OnShowLabelsChanged" />
                <Button x:Name="ImportButton" Content="Import from file..." Padding="10,2" Margin="16,0,0,0"
                        Click="OnImportMembers" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Foreground="#888" Margin="0,0,0,4"
                       Text="One identifier per line (accession, gene name or protein name):" />
            <TextBlock x:Name="ReadOnlyNote" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                       Foreground="#8a6d1f" Visibility="Collapsed"
                       Text="This panel ships with PRISM and cannot be edited. Tick it to show it on the plot, or use 'Duplicate to my lists' to make a version you can change." />
            <TextBox x:Name="MembersBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="OnMembersChanged" />
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel" Padding="16,4" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Padding="22,4" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
