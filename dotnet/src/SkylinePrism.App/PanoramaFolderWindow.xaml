<Window x:Class="SkylinePrism.App.PanoramaFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a Panorama folder" Height="560" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#555" />

        <TreeView x:Name="FolderTree" Grid.Row="1" SelectedItemChanged="OnSelectedFolderChanged" />

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PathBox" VerticalAlignment="Center"
                     ToolTip="The folder chosen in the tree, or one typed or pasted here - a path such as /MacCoss/maccoss/Project/@files/RawFiles, or an address copied from a browser." />
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Choose" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="OnChoose" />
            <Button Content="Cancel" Padding="16,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
