                                    <ComboBoxItem>Sum</ComboBoxItem>
                                    <ComboBoxItem>Median polish</ComboBoxItem>
                                    <ComboBoxItem>Top N</ComboBoxItem>
                                    <ComboBoxItem>MaxLFQ</ComboBoxItem>
