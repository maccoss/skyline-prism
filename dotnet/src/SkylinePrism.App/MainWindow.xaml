<Window x:Class="SkylinePrism.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Skyline-PRISM" Height="740" Width="1040"
        Icon="skyline-prism.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Skyline-PRISM" FontSize="22" FontWeight="Bold" Foreground="#1a3c6e" />
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,4,0,10" Foreground="#555"
                   Text="Not connected to Skyline." TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output directory:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="OutputDirBox" VerticalAlignment="Center" TextChanged="OnOutputDirChanged" />
            <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="10,4" Click="OnBrowse" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Metadata report:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" x:Name="MetadataReportCombo" VerticalAlignment="Center" IsEditable="True" />
            <TextBlock Grid.Column="2" Text="Batch column:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Grid.Column="3" x:Name="BatchColumnBox" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888"
                       Text="Pick the report carrying replicate annotations (default reads the Replicates document grid), then the batch/plate column name." TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="OpenProvenanceButton" Content="Open provenance..." Padding="12,4" Margin="0,0,8,0"
                    Click="OnOpenProvenance"
                    ToolTip="Load settings from a previous run's parameters.json into the Settings tab." />
            <Button x:Name="RunButton" Content="Run PRISM" Padding="22,4" FontWeight="Bold" Click="OnRun" />
            <Button x:Name="StopButton" Content="Stop" Padding="18,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnStop"
                    ToolTip="Stop the running pipeline. A report export already running inside Skyline cannot be recalled and will finish writing its file." />
        </StackPanel>

        <TabControl Grid.Row="5" x:Name="MainTabs" SelectionChanged="OnMainTabChanged">
            <TabItem Header="Inputs" x:Name="InputsTab">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="AddOpenDocButton" Content="Add open document..." Padding="10,4" Margin="0,0,6,0"
                                Click="OnAddOpenDocument"
                                ToolTip="Pick a document from a running Skyline instance (exported over the live connection, as parquet)." />
                        <Button Content="Add Skyline document (.sky)..." Padding="10,4" Margin="0,0,6,0"
                                Click="OnAddClosedDocument"
                                ToolTip="Pick a .sky file that is not open. PRISM exports it headlessly with SkylineCmd (invariant CSV)." />
                        <Button Content="Add exported report..." Padding="10,4" Margin="0,0,6,0"
                                Click="OnAddReportFile"
                                ToolTip="Use a PRISM report you already exported (.parquet / .csv / .tsv). No Skyline required." />
                        <Button x:Name="RemoveInputButton" Content="Remove" Padding="10,4" Margin="0,0,6,0"
                                Click="OnRemoveInput" />
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" TextWrapping="Wrap"
                                   Text="Add one input per batch. Each input's Batch label becomes its Source Document label, so identically named QC/reference replicates stay distinct across documents." />
                    </StackPanel>
                    <DataGrid x:Name="InputsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding KindLabel}" IsReadOnly="True" Width="140" />
                            <DataGridTextColumn Header="Document / file" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Batch label" Binding="{Binding BatchLabel, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Pipeline settings" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="1. Transition &#8594; peptide rollup:" Width="230" VerticalAlignment="Center" />
                            <ComboBox x:Name="TransitionRollupCombo" Width="160" SelectionChanged="OnTransitionRollupChanged">
                                <ComboBoxItem>sum</ComboBoxItem>
                                <ComboBoxItem>median_polish</ComboBoxItem>
                                <ComboBoxItem>library_assist</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="min transitions:" VerticalAlignment="Center" Margin="20,0,6,0" />
                            <TextBox x:Name="MinTransitionsBox" Width="46" Text="3" />
                            <CheckBox x:Name="UseMs1Check" Content="include MS1 precursors" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="LibraryRow" Orientation="Horizontal" Margin="0,2,0,6" IsEnabled="False">
                            <TextBlock Text="    Spectral library (.blib):" Width="230" VerticalAlignment="Center" Foreground="#444" />
                            <ComboBox x:Name="LibraryCombo" Width="330" IsEditable="True" />
                            <Button Content="Browse..." Margin="8,0,0,0" Padding="8,2" Click="OnBrowseLibrary" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="2. Peptide normalization:" Width="230" VerticalAlignment="Center" />
                            <ComboBox x:Name="PeptideNormCombo" Width="160">
                                <ComboBoxItem>rt_lowess</ComboBoxItem>
                                <ComboBoxItem>median</ComboBoxItem>
                                <ComboBoxItem>quantile</ComboBoxItem>
                                <ComboBoxItem>vsn</ComboBoxItem>
                                <ComboBoxItem>none</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="   Sample outliers:" Width="230" VerticalAlignment="Center" Foreground="#444" />
                            <CheckBox x:Name="ExcludeOutliersCheck" Content="exclude low-signal outlier samples (otherwise report only)" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="3. Peptide batch correction:" Width="230" VerticalAlignment="Center" />
                            <CheckBox x:Name="PeptideBatchCheck" Content="ComBat (peptide level)" IsChecked="True" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="4. Protein parsimony:" Width="230" VerticalAlignment="Center" />
                            <CheckBox x:Name="ParsimonyCheck" Content="group indistinguishable proteins" IsChecked="True"
                                      VerticalAlignment="Center" Checked="OnParsimonyChanged" Unchecked="OnParsimonyChanged"
                                      ToolTip="Merge proteins that share the same peptide evidence into one group. Unchecked, every accession is its own group." />
                        </StackPanel>

                        <StackPanel x:Name="SharedPeptideRow" Orientation="Horizontal" Margin="0,2,0,6">
                            <TextBlock Text="    Shared peptides:" Width="230" VerticalAlignment="Center" Foreground="#444" />
                            <ComboBox x:Name="SharedPeptideCombo" Width="160">
                                <ComboBoxItem>all_groups</ComboBoxItem>
                                <ComboBoxItem>razor</ComboBoxItem>
                                <ComboBoxItem>unique_only</ComboBoxItem>
                            </ComboBox>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" TextWrapping="Wrap"
                                       Text="How a peptide matching several groups is quantified: count it for every group, assign it to one (razor), or use only proteotypic peptides." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="5. Peptide &#8594; protein rollup:" Width="230" VerticalAlignment="Center" />
                            <ComboBox x:Name="ProteinRollupCombo" Width="160">
                                <ComboBoxItem>median_polish</ComboBoxItem>
                                <ComboBoxItem>sum</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="sum below:" VerticalAlignment="Center" Margin="20,0,6,0"
                                       ToolTip="{Binding ElementName=MinPeptidesBox, Path=ToolTip}" />
                            <TextBox x:Name="MinPeptidesBox" Width="46" Text="3">
                                <TextBox.ToolTip>
                                    <TextBlock>
                                        Groups with fewer than this many quantified peptides are rolled up by a simple<LineBreak />
                                        SUM instead of the method above (median polish is not meaningful on 1-2 peptides),<LineBreak />
                                        and are flagged low_confidence in the output.<LineBreak /><LineBreak />
                                        This is NOT a filter - no protein is dropped for having too few peptides.
                                    </TextBlock>
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock Text="peptides" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="6. Protein normalization:" Width="230" VerticalAlignment="Center" />
                            <ComboBox x:Name="ProteinNormCombo" Width="160">
                                <ComboBoxItem>median</ComboBoxItem>
                                <ComboBoxItem>none</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="7. Protein batch correction:" Width="230" VerticalAlignment="Center" />
                            <CheckBox x:Name="ProteinBatchCheck" Content="ComBat (protein level)" IsChecked="True" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="" Width="230" VerticalAlignment="Center" />
                            <CheckBox x:Name="ReferenceAnchoredCheck" VerticalAlignment="Center"
                                      Content="Anchor ComBat on the Standard samples"
                                      ToolTip="Estimate each batch's effect from the replicates whose Skyline Sample Type is Standard - identical material run in every batch - instead of from the across-batch average. Differences in that material are purely technical, so no biology is removed and the batches need not contain comparable samples. Applies to both the peptide and protein levels." />
                        </StackPanel>

                        <TextBlock Foreground="#888" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Batch correction runs only when 2+ batches are detected (set the Batch column above). Sample types come from the metadata report's Sample Type column." />
                        <TextBlock Foreground="#888" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Anchoring on the Standard samples is the better choice when the batches differ in what they contain - different case/control ratios per plate, say - because standard ComBat assumes every batch holds comparable biology and removes real signal when it does not. It needs Standard replicates in each batch; a batch without any is corrected on its own average (location only) and said so in the log." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Log" x:Name="LogTab">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" Background="#fbfbfb" Foreground="#222222" />
            </TabItem>
            <TabItem Header="QC Plots" x:Name="QcTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,6,2">
                        <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="QcViewCombo" Width="110" SelectionChanged="OnQcChanged">
                            <ComboBoxItem>Corrected</ComboBoxItem>
                            <ComboBoxItem>Raw</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Level:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="QcLevelCombo" Width="100" SelectionChanged="OnQcChanged">
                            <ComboBoxItem>Peptide</ComboBoxItem>
                            <ComboBoxItem>Protein</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Group by:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="QcGroupByCombo" Width="150" SelectionChanged="OnGroupByChanged"
                                  ToolTip="Column from the Replicates report to group samples by (defaults to Sample Type)." />
                        <TextBlock Text="=" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <ComboBox x:Name="QcGroupCombo" Width="190" IsEditable="True" IsReadOnly="True"
                                  ToolTip="Values to include. Tick more than one to combine them - e.g. Quality Control + Standard to compare the two control types without the unknowns. Tick none to show every sample.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="2,1" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Plot:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="QcPlotCombo" Width="170" SelectionChanged="OnQcChanged">
                            <ComboBoxItem>PCA</ComboBoxItem>
                            <ComboBoxItem>CV distribution</ComboBoxItem>
                            <ComboBoxItem>Intensity distribution</ComboBoxItem>
                            <ComboBoxItem>Control correlation</ComboBoxItem>
                            <ComboBoxItem>RT-lowess</ComboBoxItem>
                            <ComboBoxItem>RT-binned CV</ComboBoxItem>
                            <ComboBoxItem>RT-bin boxplot</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="(toggle View for before/after; PCA/CV/Intensity are interactive)"
                                   VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
                    </StackPanel>
                    <Grid>
                        <sp:WpfPlot x:Name="QcPlot" />
                        <Image x:Name="QcImage" Visibility="Collapsed" Stretch="Uniform" Margin="4" />
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Spectrum density" x:Name="DensityTab">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                        <TextBlock Text="Run:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="DensitySampleCombo" Width="230" SelectionChanged="OnDensitySampleChanged"
                                  ToolTip="Which acquisition to map. Every run in the merged report is listed." />
                        <TextBlock Text="Isolation scheme:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="DensitySchemeCombo" Width="200" SelectionChanged="OnDensitySchemeChanged"
                                  ToolTip="The acquisition's real isolation windows - one map row per window, so one cell is one DIA spectrum. Taken from the document when it defines a scheme; otherwise pick the scheme the data was acquired with." />
                        <TextBox x:Name="DensityMzBinBox" Width="46" Text="8.0" VerticalAlignment="Center"
                                 Margin="4,0,0,0" Visibility="Collapsed"
                                 LostFocus="OnDensityBinChanged" KeyDown="OnDensityBinKeyDown"
                                 ToolTip="Width of one uniform m/z bin, in Th. Only used by the approximate fallback - its edges are arbitrary and will not line up with the real windows." />
                        <TextBlock Text="RT bin (min):" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox x:Name="DensityRtBinBox" Width="46" Text="0.1" VerticalAlignment="Center"
                                 LostFocus="OnDensityBinChanged" KeyDown="OnDensityBinKeyDown"
                                 ToolTip="Width of one RT column, in minutes - roughly the cycle time of the method." />
                        <TextBlock Text="Max q-value:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox x:Name="DensityQValueBox" Width="52" Text="0.01" VerticalAlignment="Center"
                                 LostFocus="OnDensityQValueChanged" KeyDown="OnDensityQValueKeyDown"
                                 ToolTip="Detection q-value cutoff: only precursors at or below it count as detected. Blank counts every integrated peak." />
                        <TextBlock Text="Colors:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="DensityColormapCombo" Width="110" SelectedIndex="0"
                                  SelectionChanged="OnDensityColormapChanged">
                            <ComboBoxItem>Viridis</ComboBoxItem>
                            <ComboBoxItem>Turbo</ComboBoxItem>
                            <ComboBoxItem>Magma</ComboBoxItem>
                            <ComboBoxItem>Inferno</ComboBoxItem>
                            <ComboBoxItem>Plasma</ComboBoxItem>
                            <ComboBoxItem>Thermal</ComboBoxItem>
                            <ComboBoxItem>Grayscale</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="DensityRefreshButton" Content="Reload" Padding="10,2" Margin="16,0,0,0"
                                Click="OnDensityReload"
                                ToolTip="Re-read merged_data.parquet from the output directory above." />
                        <TextBlock x:Name="DensityStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#888" TextWrapping="Wrap" />
                        <TextBlock x:Name="DensityHoverText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#1a3c6e" TextWrapping="Wrap" />
                    </WrapPanel>
                    <sp:WpfPlot x:Name="DensityPlot" MouseMove="OnDensityPlotMouseMove" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Dynamic Range" x:Name="DynamicRangeTab">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                        <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="RangeLevelCombo" Width="90" SelectedIndex="0"
                                  SelectionChanged="OnRangeLevelChanged"
                                  ToolTip="Which corrected PRISM matrix to rank: corrected_proteins.parquet or corrected_peptides.parquet.">
                            <ComboBoxItem>Protein</ComboBoxItem>
                            <ComboBoxItem>Peptide</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Replicates:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="RangeSampleCombo" Width="210" IsEditable="True" IsReadOnly="True"
                                  ToolTip="Which replicates to average. Tick none for All.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="2,1" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Protein lists..." Padding="10,2" Margin="16,0,0,0"
                                Click="OnManageProteinLists"
                                ToolTip="Define named protein lists with colors - plasma contaminants, EV markers, endothelial markers - and toggle them on the plot." />
                        <Button Content="Reload" Padding="10,2" Margin="8,0,0,0" Click="OnRangeReload"
                                ToolTip="Re-read the corrected matrices from the output directory above." />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888"
                                   Text="Click a point to select it in Skyline; right-click for labels." />
                        <TextBlock x:Name="RangeStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#888" TextWrapping="Wrap" />
                    </WrapPanel>
                    <sp:WpfPlot x:Name="RangePlot" MouseLeftButtonUp="OnRangePlotClick" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ShortcutButton" Content="Add Start Menu shortcut" Padding="12,4" Margin="0,0,8,0"
                    Click="OnCreateShortcut"
                    ToolTip="Create a Start Menu shortcut that opens PRISM on its own, without Skyline." />
            <Button x:Name="ShowCommandButton" Content="Show Command Line" Padding="12,4" Margin="0,0,8,0"
                    Click="OnShowCommandLine"
                    ToolTip="Show the prism CLI command + config YAML that reproduces the current GUI settings." />
            <Button x:Name="OpenReportButton" Content="Open QC Report" Padding="12,4" IsEnabled="False"
                    Click="OnOpenReport" />
        </StackPanel>
    </Grid>
</Window>
