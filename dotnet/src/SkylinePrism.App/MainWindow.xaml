                                <ComboBox x:Name="QcPcYCombo" Width="52" SelectionChanged="OnQcChanged"
                                          ToolTip="Component on the y axis.">
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem IsSelected="True">2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem>4</ComboBoxItem>
                                    <ComboBoxItem>5</ComboBoxItem>
                                    <ComboBoxItem>6</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="(toggle View for before/after; PCA/CV/Intensity are interactive)"
                                           VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
