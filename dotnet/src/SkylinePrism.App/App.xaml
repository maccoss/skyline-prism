<Application x:Class="SkylinePrism.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Tooltips carry the explanations that used to sit in the Settings pane, so they are the
             only copy now rather than a convenience. Unstyled, a string tooltip renders as one
             unwrapped line - several hundred characters wide - and WPF dismisses it after five
             seconds, which is not long enough to read a paragraph. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
