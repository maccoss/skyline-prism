# Environments
.env

*.so

# Python: PRISM itself is no longer Python, but a local venv is still normal here - the docs show
# reading PRISM's parquet output with pandas, and the retired engine is one `git checkout v26.4.4`
# away.
.venv
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.ipynb_checkpoints

build/
dist/
downloads/
lib/
lib64/
parts/
var/

# Translations
*.mo
*.pot

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# VS Code
.vscode/

# Data files
*.parquet
*.csv
*.tsv
*.tmp

# Ignore large data directories
data/
output/
results/
example-files/
*.log
bug-fix/

# Exception: the C# cross-language parity fixtures are small committed goldens (~6 MB total) that
# the CI parity tests read. Re-include them despite the *.parquet / *.csv / output/ ignores above.
# The output/ directories must be un-ignored first, or git will not descend into them.
!dotnet/tests/fixtures/**/output/
!dotnet/tests/fixtures/**/*.parquet
!dotnet/tests/fixtures/**/*.csv

# Exception: dotnet/build/ is the Skyline-tool packaging script (source), not build output; keep
# package.proj. The staging/ directory beside it IS publish output and stays ignored.
!dotnet/build/
!dotnet/build/package.proj
dotnet/build/staging/

# Benchmark harness build output (dotnet/bench is intentionally outside the solution)
dotnet/bench/**/bin/
dotnet/bench/**/obj/

# coverlet writes its report into each test project directory, so running the coverage gate the way
# dotnet-ci.yml does (no /p:CoverletOutput, so the default path) leaves this behind. It is build output
# that looks like a source file, one `git add -A` away from being committed.
coverage.cobertura.xml
